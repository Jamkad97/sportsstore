<div class="container-fluid">
    <div class="row">
        <div class="col-2">
            {{> category_controls }}
        </div>
        <div class="col">
            {{> search_controls }}   
            {{#unless products}}
                <h4>No products</h4>
            {{/unless}}

            <div class="d-flex justify-content-between flex-wrap">
            {{#each products }}
                {{> product this }}
            {{/each}}
            </div>
            {{> page_controls }}
        </div>
    </div>
</div>
